name: {{watcher_folder_name}}
prefix: __lab-name

topology:
  defaults:
    labels:
      connection_mode: bgpls
      bgpls_router_ip: {{bgpls_router_ip}}
      bgpls_router_as: {{bgpls_router_as}}
      bgpls_watcher_as: {{bgpls_watcher_as}}
      bgpls_router_id: {{bgpls_router_id}}
      bgpls_passive_mode: {{bgpls_passive_mode}}
      bgpls_grpc_port: {{bgpls_grpc_port}}
      wait_sec_before_send_topology: {{wait_sec_before_send_topology}}
      ospf_area_num: {{area_num}}
      asn: {{asn}}
      organisation_name: {{organisation_name}}
      watcher_name: {{watcher_name}}
      watcher_id: {{watcher_id}}
    env-files:
    - ../../.env
  nodes:
    ospf-watcher:
      kind: linux
      image: {{image_watcher}}
      network-mode: container:bgplswatcher
      startup-delay: 10
      env:
        BGP_GRPC_PORT: '{{bgpls_grpc_port}}'
        WATCHER_LOGFILE: /home/watcher/watcher/logs/watcher.log
        ASN: {{asn}}
        WATCHER_NAME: {{watcher_name}}
        AREA_NUM: {{area_num}}
{{#server}}
        TOPOLOGRAPH_HOST: {{topolograph_host}}
        TOPOLOGRAPH_PORT: {{topolograph_port}}
        TOPOLOGRAPH_API_TOKEN: {{watcher_token}}
{{/server}}
      binds:
        # For crash dump logs if any
      - ../logs/{{watcher_folder_name}}.ospf.log:/home/watcher/watcher/logs/watcher.log
      stages:
        create:
          wait-for: []
      cmd: bgp
    logrotation:
      kind: linux
      # https://github.com/Vadims06/docker-logrotate
      image: {{image_logrotation}}
      env:
        LOGROTATE_FILE_PATTERN: '*.log'
        # don't rotate at all but truncate log, because only single log file is bind to this container
        LOGROTATE_ROTATE: '0'
        LOGROTATE_SIZE: 500M
        # once a day
        LOGROTATE_CRON: 0 0 * * *
      binds:
      - ../logs/{{watcher_folder_name}}.ospf.log:/logs/watcher.log
    bgplswatcher:
      kind: linux
      image: {{image_bgplswatcher}}
      binds:
      - bgplswatcher/config.toml:/app/config.toml:ro
{{#passive}}
      ports:
      - 179:179
{{/passive}}
